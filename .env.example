# ── Supabase (Dashboard → Project Settings → API Keys) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Solo para scripts (seed). Nunca exponerla al cliente ni subirla a Vercel como NEXT_PUBLIC.
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública de la app (redirects de magic link). En Vercel: https://<tu-app>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── IA de visión (Anthropic) ──
# Modelo pendiente de decidir (ej. claude-opus-5-5 o claude-haiku-5-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# true = análisis simulado sin llamar a la API (también se usa si falta la key o el modelo)
AI_MOCK=true

# ── Modo demo ──
# Muestra botones "Entrar como vecino / rescatista / municipio" en /login
NEXT_PUBLIC_DEMO_MODE=true
# Contraseña de los usuarios demo que crea `npm run seed` (elige una)
DEMO_PASSWORD=
