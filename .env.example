# ── Supabase (Dashboard → Project Settings → API Keys) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Solo en el servidor: seed y envío de alertas (/api/alertas). Nunca como NEXT_PUBLIC.
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública de la app (redirects de magic link). En Vercel: https://<tu-app>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── IA de visión (Anthropic) ──
# API key de platform.claude.com (créditos prepagados; el plan de claude.ai no sirve para la app).
# Haiku 5.5: el más rápido y barato, ~$0.0005 USD por foto.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# true = análisis simulado sin llamar a la API (también se usa si falta la key o el modelo)
AI_MOCK=true

# ── Modo demo ──
# Muestra botones "Entrar como vecino / rescatista / municipio" en /login
NEXT_PUBLIC_DEMO_MODE=true
# Contraseña de los usuarios demo que crea `npm run seed` (elige una)
DEMO_PASSWORD=

# ── Alertas por colonia ──
# Push (PWA). Genera las llaves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alertas@tu-dominio.mx
# Correo con Gmail: una cuenta dedicada (no la personal), verificación en dos pasos y una
# contraseña de aplicación (https://myaccount.google.com/apppasswords). ~500 correos al día, sin dominio.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Alternativa: Resend (https://resend.com/api-keys). Se usa solo si no hay Gmail configurado.
# Sin dominio verificado solo llega al dueño de la cuenta.
RESEND_API_KEY=
RESEND_FROM=CallejerOS <onboarding@resend.dev>

# ── Registro Municipal de Mascotas ──
# Hoy es la API simulada de registro-municipal-api/ (npm run dev → :4000). Vacío = se oculta esa parte.
REGISTRO_API_URL=http://localhost:4000
REGISTRO_API_KEY=demo-callejeros-2026
